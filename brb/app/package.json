{
  "name": "brb-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
