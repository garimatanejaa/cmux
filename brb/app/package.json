    "expo-build-properties": "~58.0.0",
    "expo-clipboard": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@types/node": "^22.0.0"
  }
}
